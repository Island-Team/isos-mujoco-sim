# Optional local overrides for config.toml. Set your MuJoCo installation here.
export MUJOCO_ROOT=
# Optional local development profile; repository default is isos-pkg.
# export SIM_PROFILE=dev
# export DEV_GUI=false
# Optional: use a RoboCasa checkout elsewhere; defaults to .local/robocasa.
# export ROBOCASA_ROOT=/absolute/path/to/robocasa
# Benchmark defaults live in config/benchmarks/robocasa.toml.
# Optional local overrides; list tasks with ./launch.sh --list-benchmarks.
# export BENCHMARK_TASK=CloseFridge
# export BENCHMARK_SPLIT=target
# export BENCHMARK_SCENE=1:1
# export BENCHMARK_SEED=42
# export BENCHMARK_STEPS=20
# Display one of robot0_agentview_left, robot0_agentview_right, robot0_eye_in_hand.
# export BENCHMARK_CAMERA=robot0_agentview_left
# Render resolution affects observation pixels and runtime; GUI width only scales the window.
# export BENCHMARK_CAMERA_WIDTH=256
# export BENCHMARK_CAMERA_HEIGHT=256
# export BENCHMARK_GUI_WIDTH=768
